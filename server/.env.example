NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Required: supply your own private signing secret (at least 32 characters).
JWT_SECRET=
COOKIE_SECURE=false
ADMIN_EMAIL=admin@webshield.local
ADMIN_PASSWORD=
USER_EMAIL=user@webshield.local
USER_PASSWORD=
DATABASE_URL="file:./dev.db"
# Tests create fresh disposable databases; they do not reuse DATABASE_URL.
TRUSTED_PROXY=false
# Optional exact comma-separated frontend origins. Empty uses same-origin access.
CORS_ORIGINS=
