# WebShield Server Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Security Configuration
# IMPORTANT: Change this to a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Cookie Security
# For LAN-only HTTP demonstration, set COOKIE_SECURE=false
# For production HTTPS, set COOKIE_SECURE=true
COOKIE_SECURE=false

# Optional: Trusted proxy configuration (if using reverse proxy)
# TRUSTED_PROXY=true

# Database Configuration
# Database file will be created at: prisma/dev.db
